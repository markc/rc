-- 70-functions.mix — shell helper functions.

-- One-shot system health snapshot
function health()
    print "=== System Health Check ==="
    print now_iso()
    sh "uptime -p"
    print ""
    print "=== Memory ==="
    sh "free -h"
    print ""
    print "=== Disk ==="
    sh "df -h / | tail -1"
    print ""
    print "=== Top Processes (CPU) ==="
    sh "ps aux --sort=-%cpu | head -6"
end

-- systemctl wrapper (uses $SUDO set in ~/.rc/_mixrc)
function sc($action, $service)
    sh "${SUDO}systemctl ${action} ${service}"
end

-- Edit the personal rc (~/.mixrc) and reload it in-place. Exposed as the
-- bareword `es` via the alias below: an alias whose body is a Mix call runs
-- in the REPL process (not a subshell), so the `source` reload lands in the
-- live session — aliases/functions/exports re-register globally even from
-- inside a function. nano runs via run_stream for an inherited TTY; `sh`/
-- `run` capture stdio and would break the interactive editor.
function edit_shell()
    $rc = env("HOME") .. "/.mixrc"
    run_stream(["nano", "-t", "-x", "-c", $rc])
    -- Syntax-check the edit in a child mix BEFORE sourcing, so a typo warns
    -- and leaves the live session intact instead of throwing a parse error
    -- on reload. --check parses without executing; errors land on stderr.
    $chk = run_rc("/opt/cosmix/bin/mix --check " .. shell_quote($rc))
    if $chk.rc == 0 then
        source $rc
        print "Reloaded ~/.mixrc"
    else
        print "✗ ~/.mixrc has a syntax error — NOT reloaded:"
        print trim($chk.stderr)
    end
end
alias es = "edit_shell()"

-- Generate a random password (uses Mix builtin, not /dev/urandom shell-out)
function newpw($len)
    if $len == nil then
        $len = 16
    end
    return random_password($len)
end
