-- 10-path.mix — PATH setup
--
-- ~/.rc/_bin/      shell-config-shipped scripts (sshm, etc).
-- ~/.local/bin/    machine-local user binaries.
-- $PATH            inherited (preserved at end).
--
-- User can override later from ~/.mixrc or ~/.myrc.mix.

export PATH = "${HOME}/.rc/_bin:${HOME}/.local/bin:" .. env("PATH")
