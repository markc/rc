#!/opt/cosmix/bin/mix
-- mx — run a command on a remote mix-login-shell node with the remote's
-- ~/.mixrc loaded (aliases + toolkit PATH). The mix twin of `sx` (bash -ci),
-- pointed at mix-shell nodes: it drives the remote through `mix -i -c`, so
-- remote aliases (e.g. `ll`, `df`) and toolkit PATH resolve — unlike a plain
-- `ssh host cmd`, which since mix 0.5.0 dispatches commands but without rc.
--
--   mx <host> <command...>          # host in ~/.ssh/config
--
-- Builds:  ssh -q -t <host> "mix -i -c '<command>'"
-- The remote login-shell `mix -c` dispatches the inner `mix -i -c` (resolved
-- to the node's binary via current_exe), which sources ~/.mixrc then runs the
-- command. Spawned via run_stream with an argv LIST (no /bin/sh): output
-- streams live and, because `ssh -t` allocates a remote pty, interactive
-- prompts (apt confirmations, sudo password) work — type the answer and the
-- remote sees it. `-t` cooks the output (CR/LF, escape codes) like `sx`.

$argv = args()
if length($argv) < 2 then
  print "Usage: mx <host> <command...>   (host in ~/.ssh/config; runs remote `mix -i -c`)"
  exit(1)
end

$host = $argv[0]
$cmd = $argv[1]
$i = 2
while $i < length($argv)
  $cmd = $cmd .. " " .. $argv[$i]
  $i = $i + 1
end

-- Nested quoting: shell_quote wraps <cmd> as ONE arg to the inner `mix -i -c`.
-- That whole `mix -i -c '<cmd>'` string is a single argv element here, so ssh
-- receives it as one remote-command argument — no second shell-quote needed
-- (run_stream does no shell parsing). `-q` mutes the ssh banner/close notice;
-- `-t` forces a remote pty (live stream + interactive prompts).
$remote = "mix -i -c " .. shell_quote($cmd)
exit(run_stream(["ssh", "-q", "-t", $host, $remote]))
