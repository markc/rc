#!/opt/cosmix/bin/mix
-- sshm — SSH Manager for Mix
-- Port of ~/.sh/_bin/rcm (SSH host/key management, init, sync, git)
-- Runtime path: ~/.rc/_bin/sshm  (PATH'd by ~/.rc/_lib/10-path.mix)
-- The ~/.rc/ scaffold (~/.mixrc, _mixrc, _lib/) is provisioned per the
-- README install steps, independently of this script.

$HOME = env("HOME")
$SSH = "${HOME}/.ssh"
-- The toolkit repo `sshm pull` / `sshm push` operate on. RC_SRC overrides
-- for a non-standard clone location.
if env("RC_SRC") != "" then
    $REPO = env("RC_SRC")
else
    $REPO = "${HOME}/.rc"
end

