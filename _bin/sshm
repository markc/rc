-- ========== INIT ==========

function mx_init()
    -- The ~/.rc/ scaffold (~/.mixrc, _mixrc, _lib/) is provisioned per the
    -- README install steps. sshm init only sets up ~/.ssh/ — keeps sshm
    -- self-contained (no templates ride along with sshm).
    ssh_init()
end

function ssh_init()
    -- Create SSH directory structure
    if not is_dir($SSH) then
        mkdir($SSH)
        sh "chmod 700 ${SSH}"
        print "Created ~/.ssh"
    end

    if not is_file("${SSH}/authorized_keys") then
        write_file("${SSH}/authorized_keys", "")
        sh "chmod 600 ${SSH}/authorized_keys"
        print "Created ~/.ssh/authorized_keys"
    end

    $dirs = ["hosts", "keys", "mux"]
    for each $d in $dirs
        if not is_dir("${SSH}/${d}") then
            mkdir("${SSH}/${d}")
            sh "chmod 700 ${SSH}/${d}"
            print "Created ~/.ssh/${d}"
        end
    end

    -- Create SSH config if missing
    if not is_file("${SSH}/config") then
        $date = date_format(time(), "%Y%m%d")
        $config = <<EOF
# SSH Configuration
# Created by sshm on ${date}

# Security and Performance
Ciphers aes128-ctr,aes192-ctr,aes256-ctr,aes128-gcm@openssh.com,aes256-gcm@openssh.com,chacha20-poly1305@openssh.com

# Include all host configurations from ~/.ssh/hosts/
Include ~/.ssh/hosts/*

# Global defaults for all hosts
Host *
  TCPKeepAlive yes
  ServerAliveInterval 30
  ForwardAgent yes
  AddKeysToAgent yes
  IdentitiesOnly yes
  # ControlMaster for connection multiplexing
  ControlMaster auto
  ControlPath ~/.ssh/mux/%r@%h:%p
  ControlPersist 10m
EOF
        write_file("${SSH}/config", $config)
        print "Created ~/.ssh/config"
    end

    do_perms()
    print "SSH initialized"
end

-- ========== HOST COMMANDS ==========

function host_create($name, $host, $port, $user, $skey)
    if $name == nil or $host == nil then
        print "Usage: sshm create <name> <ip> [port] [user] [keyfile]"
        return
    end
    if $port == nil then
        $port = "22"
    end
    if $user == nil then
        $user = "root"
    end
    if $skey == nil then
        $skey = "~/.ssh/keys/default"
    end

    $config = "Host ${name}\n  Hostname ${host}\n  Port ${port}\n  User ${user}\n  IdentityFile ${skey}\n"
    write_file("${SSH}/hosts/${name}", $config)
    print "Created SSH host: ${name} (${user}@${host}:${port})"
end

function host_read($name)
    if $name == nil then
        print "Usage: sshm read <name>"
        return
    end
    $path = "${SSH}/hosts/${name}"
    if is_file($path) then
        $content = read_file($path)
        print $content
    else
        print "Error: host '${name}' not found"
    end
end

function host_update($name)
    if $name == nil then
        print "Usage: sshm update <name>"
        return
    end
    $path = "${SSH}/hosts/${name}"
    if is_file($path) then
        $editor = env("EDITOR")
        if $editor == "" then
            $editor = "nano -t -x -c"
        end
        sh "${editor} ${path}"
    else
        print "Error: host '${name}' not found"
    end
end

function host_delete($name)
    if $name == nil then
        print "Usage: sshm delete <name>"
        return
    end
    $path = "${SSH}/hosts/${name}"
    if is_file($path) then
        sh "rm ${path}"
        print "Removed SSH host: ${name}"
    else
        print "Error: host '${name}' not found"
    end
end

function host_list()
    $files = glob("${SSH}/hosts/*")
    if len($files) == 0 then
        print "No hosts configured"
        return
    end
    for each $file in $files
        $basename = basename($file)
        if starts_with($basename, ".") then
            -- skip hidden files
        else
            $content = read_file($file)
            $host = ""
            $hostname = ""
            $port = "22"
            $user = "root"
            $key = ""
            $lines_list = split($content, "\n")
            for each $line in $lines_list
                $line = trim($line)
                if starts_with($line, "Host ") then
                    $host = replace($line, "Host ", "")
                else if starts_with($line, "Hostname ") then
                    $hostname = replace($line, "Hostname ", "")
                else if starts_with($line, "Port ") then
                    $port = replace($line, "Port ", "")
                else if starts_with($line, "User ") then
                    $user = replace($line, "User ", "")
                else if starts_with($line, "IdentityFile ") then
                    $key = replace($line, "IdentityFile ", "")
                end
            end
            -- Pad fields for alignment
            $host = rpad($host, 15)
            $hostname = rpad($hostname, 17)
            $port = rpad($port, 5)
            $user = rpad($user, 10)
            print "${host} ${hostname} ${port} ${user} ${key}"
        end
    end
end

function host_test($name)
    if $name != nil then
        -- Test single host
        $path = "${SSH}/hosts/${name}"
        if not is_file($path) then
            print "Error: host '${name}' not found"
            return
        end
        print "Testing ${name}..."
        $result = run_rc("ssh -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR ${name} true 2>/dev/null")
        if $result["rc"] == 0 then
            print "\e[32mOK\e[0m ${name}"
        else
            print "\e[31mFAILED\e[0m ${name}"
        end
        return
    end

    -- Test all hosts
    print "Testing SSH connectivity..."
    print ""
    $files = glob("${SSH}/hosts/*")
    $total = 0
    $success = 0
    $fail = 0

    for each $file in $files
        $name = basename($file)
        if starts_with($name, ".") or $name == "config" then
            -- skip
        else
            $total = $total + 1
            $result = run_rc("ssh -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR ${name} true 2>/dev/null")
            if $result["rc"] == 0 then
                print "  \e[32mOK\e[0m     ${name}"
                $success = $success + 1
            else
                print "  \e[31mFAILED\e[0m ${name}"
                $fail = $fail + 1
            end
        end
    end

    print ""
    print "Total: ${total}  OK: ${success}  Failed: ${fail}"
end

-- ========== KEY COMMANDS ==========

function key_create($name, $comment, $passphrase)
    if $name == nil then
        $name = "default"
    end
    if $comment == nil then
        $comment = hostname() .. "@lan"
    end
    if $passphrase == nil then
        $passphrase = ""
    end

    $path = "${SSH}/keys/${name}"
    if is_file($path) then
        print "Warning: key '${name}' already exists at ${path}"
        return
    end

    sh "ssh-keygen -o -a 100 -t ed25519 -f ${path} -C '${comment}' -N '${passphrase}'"
    if $rc == 0 then
        print "Created key: ${name}"
    else
        print "Error: key creation failed"
    end
end

function key_read($name)
    if $name == nil then
        $name = "default"
    end
    $path = "${SSH}/keys/${name}.pub"
    if is_file($path) then
        $content = read_file($path)
        print trim($content)
    else
        print "Warning: key '${name}' not found"
    end
end

function key_delete($name)
    if $name == nil then
        print "Usage: sshm key_delete <name>"
        return
    end
    $path = "${SSH}/keys/${name}"
    if is_file($path) then
        sh "rm ${path} ${path}.pub"
        print "Removed key: ${name}"
    else
        print "Error: key '${name}' not found"
    end
end

function key_list()
    $files = glob("${SSH}/keys/*.pub")
    if len($files) == 0 then
        print "No keys found"
        return
    end
    for each $file in $files
        $basename = replace(basename($file), ".pub", "")
        $fingerprint = trim(sh "ssh-keygen -lf ${file}")
        print "${basename}  ${fingerprint}"
    end
end

-- ========== SYNC ==========

function do_sync($host, $force)
    if $host == nil then
        print "Usage: sshm sync <host> [--force]"
        return
    end

    -- ---- CLOBBER GUARD ----
    -- sync is a REPLACE: the tar chain below does `rm -rf .rc && mv .rc.tmp .rc`,
    -- so whatever is at the remote ~/.rc is destroyed wholesale — .git and all.
    -- Two remotes must never be synced onto blind:
    --
    --   .rc/.git    a git clone (every mesh node). Destroying .git turns a
    --               pullable checkout into a dead copy; and syncing ONTO one
    --               without deleting .git (the old rsync --exclude=.git path)
    --               is what left the fleet permanently "dirty" against a stale
    --               HEAD in the first place. Canonical deploy is `git pull`.
    --   .rc/_shrc   the markc/sh BASH toolkit, which also lives at ~/.rc on the
    --               legacy NS 1.0 servers and is sourced from their .bashrc.
    --               A different repo that happens to share the path — replacing
    --               it with this Mix scaffold breaks that box's root shell.
    --
    -- One round trip; `test` is a bareword head, so it dispatches to the shell
    -- on a mix-login node and runs natively on a bash one. Trailing `true` keeps
    -- the exit status clean when neither marker is present.
    $probe = trim(sh "ssh ${host} 'test -e .rc/.git && echo has-git; test -e .rc/_shrc && echo has-shrc; true'")
    if contains($probe, "has-shrc") then
        print "REFUSING: ${host}:~/.rc is the markc/sh BASH toolkit (found ~/.rc/_shrc),"
        print "          not this Mix scaffold — a different repo at the same path."
        print "          Syncing would delete it out from under that host's bash login shell."
        print "          If you really mean to convert this host: remove ~/.rc there first."
        return
    end
    if contains($probe, "has-git") and not $force then
        print "REFUSING: ${host}:~/.rc is a git checkout — sync would delete it (.git included)."
        print "          Deploy with git instead:"
        print "              mx ${host} 'git -C ~/.rc pull --ff-only'"
        print "          Use `sshm sync ${host} --force` only to re-seed a broken checkout."
        return
    end
    if contains($probe, "has-git") then
        print "WARNING: --force — replacing the git checkout at ${host}:~/.rc with a plain copy"
    end

    -- Push ~/.rc/ (the scaffold), nothing more. Dev artifacts and source
    -- live on the canonical cachyos box; remotes get the rc scaffold only.
    -- The dedicated deploy_*.mix scripts in cosmix handle daemon binaries.
    $RC = "${HOME}/.rc"
    print "Syncing ~/.rc/ to ${host}:~/.rc/..."
    -- tar-over-ssh, not rsync: needs only `tar` + `ssh`, both default on every
    -- Debian/PBS box, so a fresh or deliberately-minimal server needs NO extra
    -- package (PBS CTs ship without rsync). Excludes match the old rsync's.
    -- Extract into .rc.tmp then atomically swap (gives rsync's --delete: a stale
    -- file can't survive, and a failed transfer leaves the old ~/.rc intact
    -- because the remote `&&` chain stops before the swap).
    sh "tar czf - -C ${RC} --exclude=.git --exclude=_journal --exclude=_doc . | ssh ${host} 'rm -rf .rc.tmp && mkdir -p .rc.tmp && tar xzf - -C .rc.tmp && rm -rf .rc && mv .rc.tmp .rc'"
    if $rc != 0 then
        print "Error: tar-over-ssh of ~/.rc/ failed"
        return
    end

    -- rsync stamps the synced files with the LOCAL uid/gid, so on a root remote
    -- ~/.rc lands owned by whatever uid built it (e.g. 1002), not root. When the
    -- ssh user is root (home /root), normalise it back to root:root. (mix reads
    -- it either way; this just keeps a root home tidy.)
    $remote_user = trim(sh "ssh ${host} 'id -un'")
    if $remote_user == "root" then
        sh "ssh ${host} 'chown -R root:root /root/.rc'"
        print "${host}: chowned ~/.rc to root:root"
    end

    -- Bootstrap /opt/cosmix/bin/mix on the remote if missing. Interim
    -- procedure until mix has a proper package / release artifact —
    -- scp the local binary and chmod 0755. Requires that the ssh user
    -- on the remote can write to /opt/cosmix/bin/ (i.e. is root, or
    -- /opt/cosmix/bin/ is pre-created with appropriate perms).
    $remote_mix = trim(sh "ssh ${host} 'test -x /opt/cosmix/bin/mix && echo yes || echo no' 2>/dev/null")
    $have_mix = false
    if $remote_mix == "yes" then
        print "${host} already has /opt/cosmix/bin/mix"
        $have_mix = true
    else
        if is_file("/opt/cosmix/bin/mix") then
            print "Bootstrapping /opt/cosmix/bin/mix on ${host}..."
            sh "ssh ${host} 'mkdir -p /opt/cosmix/bin'"
            sh "scp -q /opt/cosmix/bin/mix ${host}:/opt/cosmix/bin/mix"
            sh "ssh ${host} 'chmod 0755 /opt/cosmix/bin/mix'"
            print "Mix binary installed on ${host}"
            $have_mix = true
        else
            print "Warning: /opt/cosmix/bin/mix not present locally — skipping bootstrap"
            print "         Install from https://github.com/markc/mix/releases (or build from"
            print "         source: clone markc/amp + markc/mix as siblings, cargo build in ~/.mix/src)"
        end
    end

    -- PATH bridge for `mx <host>`: mx runs `ssh host "mix -i -c ..."`, so the
    -- remote's login shell must find bare `mix`. A mix-login-shell node already
    -- has /opt/cosmix/bin on PATH; a bash-login node (a stock Debian PVE/PBS
    -- host) does NOT — bridge it by symlinking mix into /usr/local/bin, which IS
    -- on the default PATH. Idempotent, and leaves bash's own rc chain untouched
    -- (the ~/.rc toolkit is only ever read by `mix -i`, never by bash).
    if $have_mix then
        $login_shell = trim(sh "ssh ${host} 'getent passwd $(id -un) | cut -d: -f7'")
        if $login_shell == "/opt/cosmix/bin/mix" then
            print "${host}: mix is the login shell — PATH already covers mix"
        else
            sh "ssh ${host} 'ln -sf /opt/cosmix/bin/mix /usr/local/bin/mix'"
            print "${host}: bridged mix onto PATH (/usr/local/bin/mix -> /opt/cosmix/bin/mix) — mx works over bash login"
        end
    end

    -- Seed ~/.mixrc — the machine-local trampoline mix auto-loads on `mix -i`,
    -- which sources the toolkit. Without it the just-synced ~/.rc is inert.
    -- Create-if-absent only: NEVER overwrite an existing ~/.mixrc (it may carry
    -- the user's machine PATH / secrets / prompt label). Relative paths resolve
    -- against the ssh login home. mix reads it fine whatever the owner.
    if $have_mix then
        $has_mixrc = trim(sh "ssh ${host} 'test -f .mixrc && echo yes || echo no'")
        if $has_mixrc == "no" then
            sh "ssh ${host} 'cp .rc/_etc/_mixrc.example .mixrc'"
            print "${host}: seeded ~/.mixrc from _mixrc.example"
        else
            print "${host}: ~/.mixrc already present (left as-is)"
        end
    end

    print "Sync completed"
end

-- ========== GIT ==========

function do_pull()
    $status = trim(sh "cd ${REPO} && git fetch origin 2>&1 && git status -sb | head -1")
    print $status

    $local = trim(sh "cd ${REPO} && git rev-parse HEAD")
    $remote = trim(sh "cd ${REPO} && git rev-parse @{u} 2>/dev/null")

    if $local == $remote then
        print "\~/.rc is up to date"
    else
        $behind = trim(sh "cd ${REPO} && git rev-list --count HEAD..@{u} 2>/dev/null")
        if $behind != "0" and $behind != "" then
            print "${behind} new commit(s) available"
            sh "cd ${REPO} && git pull --ff-only"
            if $rc == 0 then
                print "\~/.rc updated"
            else
                print "Error: pull failed (local changes?) — try: sshm push first"
            end
        else
            print "Local is ahead of upstream — use: sshm push"
        end
    end
end

function do_push($msg)
    $status = trim(sh "cd ${REPO} && git status --porcelain")

    if $status == "" then
        -- Nothing to commit — check if we need to push
        $ahead = trim(sh "cd ${REPO} && git rev-list --count @{u}..HEAD 2>/dev/null")
        if $ahead != "0" and $ahead != "" then
            print "Pushing ${ahead} commit(s)..."
            sh "cd ${REPO} && git push"
            if $rc == 0 then
                print "Pushed to origin"
            else
                print "Error: push failed"
            end
        else
            print "Nothing to commit, up to date with origin"
        end
        return
    end

    -- Build commit message
    if $msg == nil or $msg == "" then
        $changed = trim(sh "cd ${REPO} && git status --porcelain | awk '{print $2}' | tr '\\n' ' '")
        $msg = "Update: ${changed}"
    end

    sh "cd ${REPO} && git add -A && git commit -m '${msg}' && git push"
    if $rc == 0 then
        print "Committed and pushed"
    else
        print "Error: commit/push failed"
    end
end

-- ========== UTILITIES ==========

function do_perms()
    -- Directories: 700, files: 600
    $dirs = glob("${SSH}/*")
    for each $d in $dirs
        if is_dir($d) then
            sh "chmod 700 ${d}"
        end
    end
    $all_files = glob("${SSH}/**/*")
    for each $f in $all_files
        if is_file($f) then
            sh "chmod 600 ${f}"
        end
    end
    sh "chmod 700 ${SSH}"
    print "Updated permissions for ~/.ssh"
end

function do_start()
    sh "sudo systemctl start sshd"
    print "SSH daemon started"
end

function do_stop()
    sh "sudo systemctl stop sshd && sudo systemctl disable sshd"
    sh "sudo pkill -9 sshd 2>/dev/null"
    print "SSH daemon stopped and disabled"
end

-- ========== COMMAND DISPATCH ==========

$cmd = $1

if $cmd == nil or $cmd == "-h" or $cmd == "--help" then
    help_short()
else if $cmd == "ha" or $cmd == "help all" then
    help_all()
else if $cmd == "h" or $cmd == "help" then
    help_short()
else if $cmd == "i" or $cmd == "init" then
    mx_init()
else if $cmd == "s" or $cmd == "sync" then
    do_sync($2, $3 == "--force" or $3 == "-f")
else if $cmd == "c" or $cmd == "create" then
    host_create($2, $3, $4, $5, $6)
else if $cmd == "r" or $cmd == "read" or $cmd == "show" then
    host_read($2)
else if $cmd == "u" or $cmd == "update" then
    host_update($2)
else if $cmd == "d" or $cmd == "delete" then
    host_delete($2)
else if $cmd == "l" or $cmd == "list" then
    host_list()
else if $cmd == "t" or $cmd == "test" then
    host_test($2)
else if $cmd == "kc" or $cmd == "key_create" then
    key_create($2, $3, $4)
else if $cmd == "kr" or $cmd == "key_read" then
    key_read($2)
else if $cmd == "kd" or $cmd == "key_delete" then
    key_delete($2)
else if $cmd == "kl" or $cmd == "key_list" then
    key_list()
else if $cmd == "p" or $cmd == "perms" then
    do_perms()
else if $cmd == "pull" then
    do_pull()
else if $cmd == "push" then
    do_push($2)
else if $cmd == "start" then
    do_start()
else if $cmd == "stop" then
    do_stop()
else
    print "Unknown command: ${cmd}"
    help_short()
end
